# =============================================================================
# Configuração do FormSurvey — copie este arquivo para ".env" e preencha.
# O config.py carrega o .env automaticamente. O .env NUNCA vai para o
# repositório (está no .gitignore), porque contém segredos.
# O install.sh já cria o .env e gera SECRET_KEY e ADMIN_PASSWORD sozinho.
# =============================================================================

# Chave que assina o cookie de sessão. Obrigatória: sem ela o sistema não sobe.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Senha do painel administrativo (/admin). Vazia = login sempre bloqueado.
ADMIN_PASSWORD=

# Número CAAE do parecer do Comitê de Ética (aparece no texto dos termos).
CAAE=

# Endereço do chatbot de cada condição experimental (ver CONDITIONS em config.py).
#   C1 = baixa humanização, baixa personalização
#   C2 = alta  humanização, baixa personalização
#   C3 = baixa humanização, alta  personalização
#   C4 = alta  humanização, alta  personalização
# O sistema acrescenta ?token=<identificador anônimo do participante> ao final.
# Condição sem endereço próprio usa CHATBOT_URL (útil enquanto há um chatbot só).
CHATBOT_URL=https://exemplo-ifap.edu.br/chatbot-prototipo
CHATBOT_URL_C1=
CHATBOT_URL_C2=
CHATBOT_URL_C3=
CHATBOT_URL_C4=

# Ligue (1) SOMENTE quando o site estiver atrás de HTTPS (Nginx com
# certificado, ver INSTALL.md). Deixe 0 em desenvolvimento e em rede local.
FORCE_HTTPS=0
